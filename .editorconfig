root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,props,targets,slnx}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
csharp_using_directive_placement = outside_namespace:warning
# Explicit types. Do not suggest var, target-typed new, collection expressions, or primary constructors.
csharp_style_var_for_built_in_types = false:none
csharp_style_var_when_type_is_apparent = false:none
csharp_style_var_elsewhere = false:none
csharp_style_implicit_object_creation_when_type_is_apparent = false:none
csharp_style_prefer_primary_constructors = false:none
csharp_style_prefer_index_operator = false:none
csharp_style_prefer_range_operator = false:none
dotnet_style_collection_initializer = false:none
dotnet_style_object_initializer = false:none
dotnet_style_prefer_collection_expression = false:none
dotnet_style_null_propagation = false:none

# Namespace stays Txfio (and Txfio.Tests). Folders are not namespaces.
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0017.severity = none
dotnet_diagnostic.IDE0028.severity = none
dotnet_diagnostic.IDE0031.severity = none
dotnet_diagnostic.IDE0056.severity = none
dotnet_diagnostic.IDE0057.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
dotnet_diagnostic.IDE0306.severity = none
dotnet_diagnostic.IDE0350.severity = none

# Performance and parameter-order suggestions that fight this library's shape.
dotnet_diagnostic.CA1068.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2208.severity = none
dotnet_diagnostic.CA2219.severity = none

# .NET naming: private fields are _camelCase
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_pascal.symbols = constant_fields
dotnet_naming_rule.constant_fields_pascal.style = pascal_case
dotnet_naming_rule.constant_fields_pascal.severity = warning

# StyleCop: no copyright file header required
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1636.severity = none
# StyleCop: Japanese docs omit trailing 。 / . (see docs/conventions.md)
dotnet_diagnostic.SA1629.severity = none
# StyleCop: Japanese property summaries do not start with "Gets"
dotnet_diagnostic.SA1623.severity = none
# StyleCop: Japanese constructor summaries do not start with "Initializes a new instance"
dotnet_diagnostic.SA1642.severity = none
# StyleCop: .NET field naming (_camelCase) instead of this.camelCase
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1306.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1310.severity = none
dotnet_diagnostic.SA1311.severity = none
